# Same project URL + anon key must be used in the Maddex terminal app too —
# this is what lets a single Supabase Auth session work across both products.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Google Analytics 4 measurement ID (Admin → Data Streams → your stream)
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Where the terminal app and this marketing site are deployed. Used for
# cross-links (e.g. "Explore Terminal" from the checkout modal) instead of
# hardcoding a preview URL.
VITE_TERMINAL_URL=https://app.maddex.com.au
VITE_SITE_URL=https://maddex.com.au

# Server-side only (used by api/contact.js) — Resend dashboard → API Keys.
# Never prefix this with VITE_, that would bundle it into client JS.
RESEND_API_KEY=re_XXXXXXXXXX

# Server-side only (used by api/waitlist.js) — Supabase → Settings → API →
# service_role key. This bypasses Row Level Security, so it must never be
# exposed to the client or prefixed with VITE_.
SUPABASE_SERVICE_KEY=your-service-role-key
